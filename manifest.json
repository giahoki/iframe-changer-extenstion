{
  "manifest_version": 3,
  "name": "IFrame changer",
  "version": "1.0.6",
  "description": "Simple changer on IFrame.",
  "icons": {
    "16": "icons/img.png",
    "32": "icons/img.png",
    "48": "icons/img.png",
    "128": "icons/img.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "webNavigation",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/img.png",
      "32": "icons/img.png",
      "48": "icons/img.png",
      "128": "icons/img.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["polyfill.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}